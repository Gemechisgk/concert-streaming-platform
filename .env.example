# Environment Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
REALTIME_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/concert_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication (Auth.js / JWT)
AUTH_SECRET="super-secret-random-key-change-in-production-min-32-chars-long"
AUTH_URL=http://localhost:3000/api/v1/auth
JWT_SECRET="stream-token-signing-secret-key-32-chars-min"

# Streaming (SRS Media Server)
SRS_API_URL="http://localhost:1985"
SRS_RTMP_INGEST="rtmp://localhost:1935/live"
SRS_HLS_PLAYBACK="http://localhost:8080/live"
SRS_HTTP_SECRET="srs_internal_webhook_auth_token"

# Payment Providers
# Ethiopian Payment Gateways
TELEBIRR_APP_ID="telebirr_mock_app_id"
TELEBIRR_APP_KEY="telebirr_mock_app_key"
TELEBIRR_PUBLIC_KEY="telebirr_mock_pub_key"
CBE_BIRR_MERCHANT_ID="cbe_mock_merchant_id"
CHAPA_SECRET_KEY="chapa_mock_secret_key"
ARIFPAY_API_KEY="arifpay_mock_key"

# International Gateway (Stripe)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook_secret"

# Notifications (SMTP / SMS)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMS_GATEWAY_API_KEY=""
