{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm prisma generate --schema=prisma/schema.prisma && pnpm --filter @concert/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/web ./packages ./prisma"
}
